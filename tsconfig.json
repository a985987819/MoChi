{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias — 与 vite.config.ts 的 resolve.alias 保持一致
       （TS 6 起 baseUrl 已弃用，paths 直接相对 tsconfig 所在目录解析） */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* 显式引入 node 类型（TS 6 不再自动展开 @types）：单测用 node:fs 扫描工具
       注册名（tool-labels 全等断言）、vite.config.ts 也要 node:path/url/process */
    "types": ["node"]
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
